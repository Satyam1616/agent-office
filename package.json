{
  "name": "agent-office",
  "private": true,
  "description": "3D live view of every coding agent working on this machine",
  "workspaces": [
    "apps/*"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:demo": "bun run --filter @agent-office/collector dev:demo & bun run --filter @agent-office/web dev",
    "start": "bun run --filter @agent-office/web build && bun apps/collector/src/index.ts",
    "relay": "bun apps/collector/src/index.ts",
    "dev:collector": "bun run --filter @agent-office/collector dev",
    "dev:web": "bun run --filter @agent-office/web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "app:dev": "bun run --filter @agent-office/desktop app:dev",
    "app:build": "bun run --filter @agent-office/desktop app:build"
  },
  "patchedDependencies": {
    "three-stdlib@2.36.1": "patches/three-stdlib@2.36.1.patch"
  }
}
